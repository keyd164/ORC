<view class="page"><view class="card"><text class="section-title">筛选账单</text><input placeholder="账单编号" data-key="bill_no" value="{{filters.bill_no}}" bindinput="input"/><input placeholder="房间名称" data-key="room" value="{{filters.room}}" bindinput="input"/><view class="grid"><picker mode="date" value="{{filters.start}}" data-key="start" bindchange="input"><view class="picker">票面起日 {{filters.start || '不限'}}</view></picker><picker mode="date" value="{{filters.end}}" data-key="end" bindchange="input"><view class="picker">票面止日 {{filters.end || '不限'}}</view></picker><input placeholder="最低实收（元）" data-key="min" value="{{filters.min}}" bindinput="input"/><input placeholder="最高实收（元）" data-key="max" value="{{filters.max}}" bindinput="input"/></view><picker range="{{reviews}}" value="{{reviewIndex}}" bindchange="review"><view class="picker">复核状态：{{reviews[reviewIndex]}}</view></picker><picker range="{{settlements}}" value="{{statusIndex}}" bindchange="status"><view class="picker">结算状态：{{settlements[statusIndex]}}</view></picker><view class="row"><button class="small" bindtap="refresh" loading="{{busy}}">查询</button><button class="small secondary" bindtap="reset">重置</button><button class="small secondary" bindtap="export" disabled="{{busy}}">Excel</button><button class="small secondary" bindtap="exportCsv" disabled="{{busy}}">CSV</button></view></view><view class="card" wx:if="{{localFile}}"><text class="muted">最近导出：{{lastName}}</text><button class="secondary" bindtap="saveFile" disabled="{{busy}}">打开文件菜单，手动保存</button></view><view class="error" wx:if="{{error}}">{{error}}</view><view class="muted">{{rows.length}} 条匹配记录 · 金额为元</view><view class="card" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="row"><text class="record-title">{{item.bill_no || '编号待补充'}}</text><text>¥{{item.money}}</text></view><view class="line">{{item.room_name || '房间待补充'}} · {{item.bill_date || '日期未识别'}}</view><text class="badge">{{item.reviewText}}</text><text class="badge warning" wx:if="{{item.duplicate_status !== 'none'}}">{{item.duplicateText}}</text><text class="muted">{{item.bill_status || '结算状态待补充'}}</text></view><view class="empty" wx:if="{{!rows.length && !busy && !error}}">没有符合条件的账单。</view></view>
