<view class="page"><view class="card"><text class="section-title">上传记录</text><picker mode="date" bindchange="changeDate" value="{{date}}"><view class="picker">归档日期：{{date || '全部'}}　›</view></picker><view class="row"><button class="small secondary" bindtap="clear">全部日期</button><button class="small secondary" bindtap="refresh" loading="{{busy}}">刷新</button></view><text class="muted">排队与识别中的记录每 5 秒自动刷新。</text></view><view class="error" wx:if="{{error}}">{{error}}</view><view class="card row" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><image class="thumbnail" src="{{base}}/images/{{item.id}}/file?thumbnail=true" mode="aspectFit"/><view class="record-body"><text class="record-title">{{item.bill_no || item.original_name}}</text><view class="line">{{item.room_name || '房间待识别'}} · ¥{{item.money}}</view><text class="badge">{{item.statusText}}</text><view class="muted">{{item.business_date}}</view><view class="muted" wx:if="{{item.error_message}}">{{item.error_message}}</view></view></view><view class="empty" wx:if="{{!rows.length && !busy && !error}}">暂无上传记录，请从首页采集账单。</view><button class="secondary" wx:if="{{hasMore && rows.length}}" bindtap="more" loading="{{busy}}">加载更多</button></view>
