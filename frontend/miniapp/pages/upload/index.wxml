<view class="page"><view class="card"><text class="section-title">账单采集</text><picker mode="date" value="{{date}}" disabled="{{busy}}" bindchange="changeDate"><view class="picker">归档日期：{{date}}　›</view></picker><text class="muted">归档日期与票面账单日期分别保存。单张最多 15MB。</text><button bindtap="choose" disabled="{{busy}}">拍照 / 从相册选图</button></view><view class="error" wx:if="{{error}}">{{error}}</view><view class="notice" wx:if="{{message}}">{{message}}</view><view class="card" wx:for="{{files}}" wx:key="uid"><image class="receipt" src="{{item.path}}" mode="widthFix" data-path="{{item.path}}" bindtap="preview"/><text class="badge">{{item.status}}</text><progress percent="{{item.progress}}" activeColor="#12634d" show-info/><text class="error" wx:if="{{item.error}}">{{item.error}}</text><view class="row"><button class="small secondary" data-id="{{item.uid}}" bindtap="remove" disabled="{{busy}}">移除</button><button wx:if="{{item.imageId}}" class="small secondary" data-id="{{item.imageId}}" bindtap="open">识别详情</button></view></view><button bindtap="upload" loading="{{busy}}" disabled="{{busy || !files.length}}">上传 / 重试失败图片</button><button class="secondary" bindtap="records">查看识别记录</button></view>
