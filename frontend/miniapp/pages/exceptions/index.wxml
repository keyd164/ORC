<view class="page"><view class="card"><text class="section-title">异常与待办</text><button wx:for="{{filters}}" wx:key="key" class="small {{filter === item.key ? '' : 'secondary'}}" data-key="{{item.key}}" bindtap="filter">{{item.label}}</button><button class="secondary" bindtap="refresh" loading="{{busy}}">刷新</button></view><view class="error" wx:if="{{error}}">{{error}}</view><view class="card" wx:for="{{visibleBills}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="record-title">{{item.bill_no || '账单编号待补充'}} · {{item.room_name || '房间待补充'}}</view><text class="badge">{{item.reviewText}}</text><text class="badge warning" wx:if="{{item.duplicate_status !== 'none'}}">{{item.duplicateText}}</text><view class="muted" wx:for="{{item.issues}}" wx:for-item="issue" wx:key="*this">{{issue}}</view><text class="link">打开原图并处理 ›</text></view><view class="card" wx:for="{{visibleImages}}" wx:key="id" data-id="{{item.id}}" bindtap="image"><text class="badge warning">识别失败</text><view>{{item.original_name}}</view><view class="muted">{{item.error_message}}</view><text class="link">查看原图 / 重新识别 ›</text></view><view class="empty" wx:if="{{!visibleBills.length && !visibleImages.length && !busy && !error}}">当前分类没有待处理记录。</view></view>
