# This file is a template. The current launcher reads OS environment variables;
# copying to .env alone does not load it automatically.
# KTV_DATA_DIR=E:/KTV-ORC/data
KTV_DURATION_TOLERANCE_MINUTES=15
# Optional LOCAL model planning. Rules mode needs no model.
KTV_OLLAMA_URL=http://127.0.0.1:11434
# Use an already downloaded local model that supports JSON schema output.
KTV_OLLAMA_MODEL=
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
